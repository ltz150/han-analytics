{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ltz-analytics",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "analytics_engine_datasets": [
    { "binding": "AnalyticsBinding", "dataset": "AnalyticsDataset" }
