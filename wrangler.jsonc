  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "f64001310a9dfa3e502fc6617acef621",
    "CLOUDFLARE_WEBSITE_WHITELIST": "blog.litianzeng.cn,LTZ-Blog"
  }
}
